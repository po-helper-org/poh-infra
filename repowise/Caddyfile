# Публичный вход сервиса Repowise. Единственная точка, доступная снаружи.
#
# За этим паролем — клоны ВСЕХ репозиториев организации и ключ модели. Доступ к
# админке равен доступу к коду, поэтому пароль не переиспользуется с Temporal UI
# контура и заводится отдельным.

:80 {
	log {
		output stdout
		format console
	}

	# Живость сервиса без учётных данных: проверять доступность входа должно
	# быть можно, не имея доступа к содержимому.
	handle /health {
		respond "repowise entry ok" 200
	}

	# MCP наружу не выходит НИКОГДА. Явный 404, а не отсутствие маршрута:
	# отсутствие маршрута отвечало бы тем же кодом, но не сказало бы,
	# что так задумано, — и следующий человек завёл бы проброс «для удобства».
	handle /mcp* {
		respond "MCP доступен только из внутреннего контура через прокси" 404
	}

	# Веб-админка Repowise на корне домена.
	#
	# Basic-auth ЗДЕСЬ, а не меткой Traefik: вход отвечает на обоих
	# entrypoint'ах (web и websecure), и защита на одном из них означала бы
	# открытый интерфейс по второму адресу.
	#
	# Обе переменные обязательны — без них caddy не поднимется вовсе, и это
	# намеренно: молча открытая админка хуже упавшего входа.
	#
	# Хэш: docker run --rm caddy:2-alpine caddy hash-password --plaintext '<пароль>'
	# Доллары в хэше УДВАИВАТЬ при записи в env-файл (см. docker-compose.yml).
	# `repowise serve` поднимает ДВА процесса: API на Python (7337) и веб-интерфейс
	# на Node (3000). Человеку нужен интерфейс, интерфейсу — API, поэтому корень
	# идёт на 3000, а всё под /api и /openapi.json — на 7337.
	#
	# Ключ API подставляется только на путях API: интерфейсу он не нужен, а
	# лишний заголовок на статике — повод для вопросов на ревью.
	@api path /api/* /openapi.json /docs*
	handle @api {
		basic_auth {
			{$REPOWISE_WEB_USER} {$REPOWISE_WEB_PASSWORD_HASH}
		}
		reverse_proxy repowise-web:7337 {
			# Заголовок Authorization ПЕРЕПИСЫВАЕТСЯ, а не пробрасывается.
			#
			# Оба слоя доступа пользуются одним заголовком: человек предъявляет
			# входу логин с паролем, а сам repowise ждёт `Bearer` со своим
			# ключом. Пробросить исходный заголовок значит отдать repowise
			# `Basic …`, на что он отвечает 401 — админка при этом открывается,
			# показывает интерфейс и не может получить ни одного ответа от API.
			#
			# Ключ подставляет вход, потому что человеку его знать незачем:
			# он уже доказал право входа паролем.
			header_up Authorization "Bearer {$REPOWISE_API_KEY}"
		}
	}

	# Веб-интерфейс — всё остальное.
	handle {
		basic_auth {
			{$REPOWISE_WEB_USER} {$REPOWISE_WEB_PASSWORD_HASH}
		}
		reverse_proxy repowise-web:3000
	}
}
