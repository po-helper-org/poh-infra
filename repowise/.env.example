# Сервис Repowise — переменные окружения.
#
#   cp .env.example .env && $EDITOR .env
#
# Порядок развёртывания и проверочный список — docs/repowise/deploy.md.

# --- Доступ агентов к индексу ---
# Токен предъявителя для MCP-прокси. Тот же самый задаётся агентам контура как
# REPOWISE_AGENT_TOKEN. Пустой означает НЕ «пускать всех», а закрытый вход:
# прокси отвечает 503.
#   openssl rand -hex 24
REPOWISE_AGENT_TOKEN=

# --- Веб-админка ---
# Собственный guard пакета: при привязке к не-loopback адресу без этого ключа
# API отвечает 403. Это второй слой доступа помимо basic_auth на входе.
#   openssl rand -hex 24
REPOWISE_API_KEY=

# Домен админки. ВНИМАНИЕ: имя REPOWISE_HOST занято самим пакетом под адрес
# привязки сокета — домен в нём заставит эндпоинт слушать на несуществующем
# адресе. Здесь именно REPOWISE_PUBLIC_HOST.
REPOWISE_PUBLIC_HOST=repowise.localhost
# Порт публикации входа на хосте.
REPOWISE_PORT=8090

# Учётка входа НЕ здесь: панель Dokploy переписывает .env каждым деплоем.
# Логин и bcrypt-хэш кладутся в ./caddy.env (локально, в .gitignore) либо в
# /etc/poh-repowise/web-auth.env (стенд):
#   REPOWISE_WEB_USER=...
#   REPOWISE_WEB_PASSWORD_HASH=$$2a$$14$$...   ← доллары УДВОЕНЫ
# Хэш: docker run --rm caddy:2-alpine caddy hash-password --plaintext '<пароль>'

# --- Клонирование репозиториев ---
# Токен с правом чтения репозиториев организации. Пусто — доступны только
# публичные. Индексатор отдаёт его git через хелпер, а не подстановкой в URL:
# подставленный в argv токен уезжает в текст любого исключения.
REPOWISE_GIT_TOKEN=

# --- Модель и эмбеддер ---
# Провайдер для генерации страниц вики. Пусто — вики остаётся структурной:
# она строится без модели и без трат, и это работоспособный индекс.
# z.ai подходит как OpenAI-совместимый: REPOWISE_PROVIDER=openai
REPOWISE_PROVIDER=
REPOWISE_MODEL=
REPOWISE_LLM_API_KEY=
REPOWISE_LLM_BASE_URL=

# Эмбеддер для семантического поиска: openai | gemini | openrouter | ollama.
# У z.ai эмбеддингов НЕТ — проверено спайком FR-1, вызовы отвергаются с
# «Unknown Model» (код 1211), векторный индекс остаётся пустым. Нужен отдельный
# ключ провайдера с эмбеддингами либо ollama рядом. Пусто — поиск по смыслу
# недоступен, полнотекстовый работает.
REPOWISE_EMBEDDER=

# --- Индексация ---
# Какие workspace обслуживать.
REPOWISE_WORKSPACES=contour,product
# Интервал цикла синхронизации, секунды.
REPOWISE_SYNC_INTERVAL=3600
# С какого возраста индекс считается отставшим (для /index-age и шапки
# артефакта диалога). По умолчанию два интервала синхронизации.
REPOWISE_STALE_AFTER_SEC=7200
