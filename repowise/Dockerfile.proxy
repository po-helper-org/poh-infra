# MCP-прокси: единственный компонент сервиса, видимый контуру производства.
#
# Отдельный образ, а не слой поверх образа Repowise: прокси не нужен ни git, ни
# сам пакет — он не разбирает семантику инструментов и передаёт полезную
# нагрузку насквозь. Раздельные образы означают, что обновление версии Repowise
# прокси не пересобирает и наоборот.
FROM python:3.12-slim

RUN pip install --no-cache-dir \
      "fastapi==0.115.6" \
      "uvicorn[standard]==0.34.0" \
      "httpx==0.28.1"

COPY proxy/proxy.py /app/proxy.py
WORKDIR /app

# Слушает 0.0.0.0: контейнер публикуется только во внутреннюю сеть контура,
# наружу его порт не выходит — граница проходит по сети compose, а не здесь.
CMD ["uvicorn", "proxy:app", "--host", "0.0.0.0", "--port", "7400"]
