# /etc/default/poh-harness-isolation — параметры барьера на конкретном хосте.
# HARNESS_NET  — docker-сеть контура (docker network ls, обычно <compose-проект>_default)
# FOREIGN_NETS — сети соседних стеков, которым контур не должен быть доступен
# PORTS        — порты соседей, опубликованные на адресах хоста
HARNESS_NET=<compose-проект>_default
FOREIGN_NETS="temporal-network"
PORTS=7233,5432,8080
