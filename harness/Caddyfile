# Единственная публичная точка контура. Три сервиса за одним хостом, потому что
# адрес вебхука прописывается в настройках GitHub App руками — и каждый лишний
# хост это ещё одно место, где конфигурация может разъехаться незаметно.
#
# Пути фиксированы: они уходят в настройки двух App и в секрет ISSUE_AGENT_URL
# репозиториев. Переименование здесь ломает контур молча.

:80 {
	log {
		output stdout
		format console
	}

	# Живость всего харнесса одним запросом. Проверяем оба агента, а не только
	# прокси: 200 от caddy, за которым лежит мёртвый воркер, — худший из ответов.
	handle /health {
		respond "harness ok" 200
	}

	# --- Issue-Agent ---
	# /issue/webhook       ← GitHub App «Issue-Agent»
	# /issue/agent-event   ← OpenHands (Actions) и PR-Agent, если он снаружи
	handle_path /issue/* {
		reverse_proxy issue-webhook:3000
	}

	# --- PR-Agent ---
	# /pr/webhook  ← GitHub App «PR-Agent».
	# Легаси-путь pr-agent (/api/v1/github_webhooks) ingress принимает сам, но он
	# остаётся ПОД префиксом: наружу у харнесса ровно две точки приёма вебхуков,
	# и обе видны по первому сегменту пути.
	handle_path /pr/* {
		reverse_proxy pr-ingress:3000
	}

	# --- Temporal UI ---
	# На корне домена, НЕ под /temporal/*. Образ temporalio/ui собран как SPA с
	# base-path, зашитым в JS как "" (пусто): страница просит свои ассеты
	# абсолютными путями `/_app/...` независимо от того, под каким префиксом её
	# открыли. `TEMPORAL_UI_PUBLIC_PATH` эту генерацию НЕ переписывает — он
	# двигает только серверные API-роуты самого UI, а не собранный фронтенд.
	# Под /temporal/* это выглядело как пустая белая страница: запрос ассета
	# уходил на `/_app/...` мимо `handle_path`, ловил общий 404, и SvelteKit не
	# успевал даже подключиться. Единственный рабочий вариант для этой версии
	# образа — отдать UI весь домен; остальные три пути (`/issue`, `/pr`,
	# `/health`) — простые API без собственных ассетов, им префикс не мешает.
	#
	# Basic-auth здесь, а не меткой Traefik: вход отвечает на обоих
	# entrypoint'ах (web и websecure), и защита на одном из них означала бы
	# открытый UI по второму адресу.
	#
	# Пароль хранится хэшем: `docker run --rm caddy:2-alpine caddy hash-password
	# --plaintext '<пароль>'`. Обе переменные обязательны — без них вход не
	# поднимется вовсе, и это намеренно: молча открытый UI хуже упавшего входа.
	handle {
		basic_auth {
			{$TEMPORAL_UI_USER} {$TEMPORAL_UI_PASSWORD_HASH}
		}
		reverse_proxy harness-temporal-ui:8080
	}
}
