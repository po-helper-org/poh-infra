# Harness контура производства — один конфиг на весь цикл.
#
#   cp .env.example .env && $EDITOR .env && docker compose up -d --build
#
# Обязательное помечено ОБЯЗАТЕЛЬНО: без него `docker compose up` падает сразу,
# на подстановке переменной, а не через десять минут сборки. Это намеренно —
# половина контура, поднятая с забытым секретом, выглядит работающей.

# ══════════════════════════ 1. Что охраняем ══════════════════════════

# Репозитории, за которыми следит контур. ОБЯЗАТЕЛЬНО.
# Формат: owner/repo,owner2/*  — маска покрывает и репозитории, заведённые позже.
# Один список на обоих агентов: разъехавшийся охват означает PR без ревью либо
# ревью без задачи.
WATCHED_REPOS=your-org/your-repo

# Репозиторий по умолчанию для batch-скриптов (backfill, consolidate).
DEFAULT_REPO=your-org/your-repo

# --- GitLab: второй провайдер ---
# Контур работает с обоими трекерами одновременно. WATCHED_REPOS говорит, КАКИЕ
# репозитории обслуживать; GITLAB_REPOS — какие из них живут в GitLab.
# Формат тот же. ПУСТО ОЗНАЧАЕТ «все идут в GitHub», то есть прежнее поведение.
GITLAB_REPOS=

# Свой инстанс — свой адрес. По умолчанию облачный gitlab.com.
GITLAB_URL=https://gitlab.com

# Токен со scope `api` и ролью Maintainer в проекте (иначе не заведётся вебхук).
# На бесплатном gitlab.com годится только Personal Access Token: Project и Group
# Access Token там требуют Premium вопреки бейджу Free. Срок ≤365 дней,
# бессрочные запрещены с версии 16.0.
GITLAB_TOKEN=

# Секрет вебхука. В режиме hmac это signing token вида `whsec_<base64>`.
GITLAB_WEBHOOK_SECRET=

# hmac доступен с GitLab 19.0 (GA 19.1); token — везде и слабее. Режим задаётся
# явно и не угадывается по заголовкам: угадывание означало бы, что отправитель
# сам выбирает, как его проверять.
GITLAB_SIGNATURE_MODE=hmac

# Логин сервисного аккаунта: поля user.type у GitLab нет вовсе.
# НЕ СТАВИТЬ логин живого владельца токена — его собственные задачи будут
# помечены bot-authored и пропущены. Пусто, пока отдельного аккаунта нет:
# свои комментарии контур опознаёт по маркеру в теле, а не по автору.
GITLAB_BOT_LOGIN=

# ═══════════════════════ 2. Два GitHub App ═══════════════════════════
#
# Приложений именно два, и это не дублирование: у Issue-Agent свои права и свои
# события (Issues, Issue comments, sub-issues), у PR-Agent свои (Pull requests,
# Reviews, Push). Одно приложение на оба означало бы, что утечка ключа открывает
# сразу и бэклог, и код.
#
# Приватный ключ — в base64:  base64 -w0 app-private-key.pem
# Вебхук каждого App указывает на СВОЙ путь одного домена (см. PUBLIC_URL):
#   Issue-Agent → https://<host>/issue/webhook
#   PR-Agent    → https://<host>/pr/webhook

# --- App «Issue-Agent» ---
ISSUE_APP_ID=
ISSUE_APP_PRIVATE_KEY_B64=
ISSUE_APP_WEBHOOK_SECRET=          # ОБЯЗАТЕЛЬНО (openssl rand -hex 32)

# Запасной путь: PAT вместо App. github_client предпочитает токен, если он задан,
# и тогда три переменные выше можно оставить пустыми. Права: repo.
GH_TOKEN=

# --- App «PR-Agent» ---
PR_APP_ID=                         # ОБЯЗАТЕЛЬНО
PR_APP_PRIVATE_KEY_B64=            # ОБЯЗАТЕЛЬНО
PR_APP_WEBHOOK_SECRET=             # ОБЯЗАТЕЛЬНО (openssl rand -hex 32)

# ════════════════════════ 3. Замок контура ═══════════════════════════

# Секрет подписи докладов внешних агентов (POST /agent-event). ОБЯЗАТЕЛЬНО.
# Одна строка на обе стороны канала: им подписывают доставку PR-Agent и прогон
# OpenHands в Actions. Пусто → эндпоинт закрыт (503), доклады о PR и ревью не
# доходят, и задача остаётся ждать в `in-development` навсегда.
#
# ЭТУ ЖЕ строку положи секретом `AGENT_EVENT_SECRET` в каждый репозиторий из
# WATCHED_REPOS, рядом с `ISSUE_AGENT_URL=<PUBLIC_URL>/issue`.
AGENT_EVENT_SECRET=

# ═════════════════════════ 4. Модель ═════════════════════════════════

ZAI_API_KEY=                       # ОБЯЗАТЕЛЬНО
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# Подобраны замером, не по прейскуранту: в контейнере воркера
# `python scripts/model_probe.py` гоняет настоящие промпты стадий по моделям
# аккаунта. Прогон 2026-09-09: схему держат все десять, `glm-5.2` тратит меньше
# всех выходных токенов и отвечает вдвое быстрее прежних значений.
MODEL_GATE=glm-5.2
MODEL_CLASSIFY=glm-5.2
PR_AGENT_MODEL=openai/glm-4.6

# Модель пути `claude -p` (стадии FNR и БФТ) — ЕДИНСТВЕННАЯ переменная модели,
# которую нельзя оставлять пустой. Остальные стадии называют модель явно;
# `claude -p` вызывается без `--model`, и пустое значение означает не
# «умолчание контура», а «пусть решает провайдер». Провайдер выбирает самую
# свежую модель, и делает это на самом долгом пути: стадия идёт до 900 секунд.
#
# Подобрать под свой тариф: в контейнере воркера
# `python scripts/model_probe.py glm-4.5-air glm-4.6 --claude`.
ANTHROPIC_MODEL=glm-5.2

# ═════════════════ 5. Насколько контур автономен ═════════════════════

# 1 — ни одной мутации в GitHub: комментарии, метки и реакции только в лог.
# Держи 1 до первого удачного прогона.
DRY_RUN=1

# Передача задачи агенту разработки. Пусто = включено.
# `0` оставляет Issue в `ready-for-dev`, то есть в очереди к живому
# разработчику, — это поведение до появления Develop и процедура отката.
DEVELOP_ENABLED=

# 1 — не парковаться на `ready-for-dev`: контур идёт от Issue до PR без единого
# касания человека. Пусто (умолчание) — разработку начинает метка `build-me`.
DEVELOP_AUTOSTART=

# Где пишется код.
#   local    — одноразовым контейнером на своём сервере (умолчание). Контур
#              замкнут: репозиторий обслуживается целиком внутри стенда.
#   dispatch — прогон уезжает в GitHub Actions репозитория-цели.
DEVELOP_MODE=local

# Проверки проекта. Гоняются ПОСЛЕ агента и ДО пуша: красный код не должен
# доезжать до PR, а на PR от агента CI может и не запуститься вовсе.
# Пусто — шаг пропускается.
DEVELOP_TEST_COMMAND=node --test "tests/*.test.mjs"

DEVELOP_MODEL=openai/glm-4.6
DEVELOP_TIMEOUT_SEC=2700

# Тег образа одноразового агента. Воркер запускает контейнер ПО ЭТОМУ ИМЕНИ,
# поэтому значение обязано совпадать с тем, чем помечена сборка
# `openhands-runner`, — они разъезжаются молча: сборка проходит, а прогон
# падает на отсутствующем образе уже внутри задачи.
DEVELOP_RUNNER_IMAGE=poh-openhands-runner:local

# Только для DEVELOP_MODE=dispatch:
DEVELOP_WORKFLOW_FILE=openhands-resolver.yml
DEVELOP_REF=main

# Кто вправе запускать дорогие стадии: GitHub-логины через запятую.
# Пусто = разрешено всем. Проверяется автор события, а не наличие метки:
# `run:analyze` может поставить любой с правами на репозиторий, а прогон стоит
# токенов. Триаж новых Issue гейтом НЕ закрыт — иначе Issue от постороннего
# просто не обработается.
AGENT_TRIGGER_ALLOWLIST=

# Сроки парковок, часы (правило R3: каждое ожидание имеет дедлайн).
PARK_DECISION_HOURS=72
PARK_CLARIFICATION_HOURS=48
PARK_BUILD_HOURS=72
PARK_SIDE_STATE_HOURS=168

# ═══════════════════════ 6. Инфраструктура ═══════════════════════════

POSTGRES_PASSWORD=                 # ОБЯЗАТЕЛЬНО (openssl rand -hex 24)

# Порт харнесса на хосте. Внутри всё стандартное, наружу — только этот.
HARNESS_PORT=8080

# Temporal UI помимо префикса `/temporal` доступен и напрямую — чтобы отличить
# «UI не работает» от «маршрутизация до UI не работает». Порт слушает только
# loopback: снаружи UI закрыт basic-auth'ом, второй открытый порт снял бы её.
TEMPORAL_UI_PORT=8233

# Учётка на Temporal UI живёт НЕ здесь, а в отдельном файле — `harness/caddy.env`
# локально, `/etc/poh-harness/temporal-ui-auth.env` на стенде:
#
#   TEMPORAL_UI_USER=poh
#   TEMPORAL_UI_PASSWORD_HASH=$$2a$$14$$…   # caddy hash-password, доллары УДВОЕНЫ
#
# Причина отдельного файла — .env на стенде переписывается панелью Dokploy на
# каждом деплое. Причина удвоенных долларов — compose интерполирует значения
# любого env-файла, и bcrypt-хэш из `$`-сегментов доехал бы обрезанным.

# Хост стенда для Traefik (Dokploy). Заводит роутеры на web и websecure; на
# websecure сертификат выписывает резолвер letsencrypt самого Dokploy.
# Без Traefik (локальный запуск) переменная не нужна.
HARNESS_HOST=harness.localhost

# Публичный адрес стенда. Нужен Temporal UI для CORS и тебе — чтобы собрать
# адреса вебхуков: <PUBLIC_URL>/issue/webhook и <PUBLIC_URL>/pr/webhook.
PUBLIC_URL=http://localhost:8080

# Откуда собираются образы. Контекст задаётся ЦЕЛИКОМ одной строкой: сюда
# кладут и `…git#ветка`, и локальный путь к рабочей копии.
#
# На отладке ставь локальный путь. BuildKit кэширует git-клон по URL, и сборка
# после нового коммита в ту же ветку может молча взять прежний код — правка
# уезжает в main, образ «пересобирается», а в контейнере остаётся старый файл.
ISSUE_AGENT_CONTEXT=https://github.com/po-helper-org/poh-issue-agents.git#main
PR_AGENT_CONTEXT=https://github.com/po-helper-org/poh-pr-agents.git#main:self-hosted
# Стадия разработки: образ одноразового агента. Контекст КОРНЕВОЙ — внутри
# репозитория нужный Dockerfile выбирается ключом `dockerfile:` в compose, как
# у ISSUE_AGENT_CONTEXT, который тем же значением обслуживает три сервиса.
DEVELOPER_AGENT_CONTEXT=https://github.com/po-helper-org/poh-developer-agents.git#main
# Отладка на рабочей копии:
# ISSUE_AGENT_CONTEXT=/путь/к/poh-issue-agents
# PR_AGENT_CONTEXT=/путь/к/poh-pr-agents/self-hosted
# DEVELOPER_AGENT_CONTEXT=/путь/к/poh-developer-agents

# Search attributes Temporal: одна лента на всю цепочку от триажа до PR.
# ВКЛЮЧАТЬ ТОЛЬКО ПОСЛЕ регистрации атрибутов на кластере, иначе старт
# воркфлоу падает:
#   temporal operator search-attribute create --name RootIssue --type Int
#   temporal operator search-attribute create --name Repo --type Keyword
TEMPORAL_SEARCH_ATTRIBUTES=

# Sentry: пусто → выключен (это же и процедура отката).
SENTRY_DSN=
SENTRY_ENVIRONMENT=harness

# ─────────────── Слой саморефлексии (harness-memory-base) ───────────────
#
# ОПЦИОНАЛЕН. Пусто — контур поднимается и работает ровно как раньше.
#
# Подключённый слой даёт агентам правила и принципы, накопленные ЭТОЙ
# организацией, и принимает от них запись о каждой итерации. Разворачивается
# отдельным compose — см. `memory/README.md` и `docs/harness/self-reflection.md`.
#
# Сеть `harness-memory-net` создаёт compose САМОГО СЛОЯ — руками её заводить не
# надо: compose не признаёт своей сеть без своих меток и откажется стартовать.
MEMORY_BASE_URL=
# Тот же токен, что в `memory/.env`. ТОЛЬКО ASCII: значение едет заголовком
# HTTP, а заголовки кириллицу не принимают.
MEMORY_BASE_TOKEN=
MEMORY_BASE_TIMEOUT_SEC=5
# Контрольная выборка: каждая N-я задача идёт БЕЗ подсыпанных правил. Без неё
# вопрос «слой не мешает?» неотвечаем — сравнивать не с чем. Пусто или 0 —
# выборки нет. Включать на время проверки, не насовсем.
MEMORY_CONTROL_MOD=

# --- приёмка по HowToDemo ---
#
# Автозапуск при открытии PR. Пусто или 0 — приёмка идёт только по команде
# `/howtodemo` и метке `run:howtodemo`. Он же рубильник отката.
HOWTODEMO_AUTOSTART=
# Сеть стенда. Пусто — агент выясняет её сам, это штатный режим.
HOWTODEMO_NETWORK=
