# Harness контура производства — один конфиг на весь цикл.
#
#   cp .env.example .env && $EDITOR .env && docker compose up -d --build
#
# Обязательное помечено ОБЯЗАТЕЛЬНО: без него `docker compose up` падает сразу,
# на подстановке переменной, а не через десять минут сборки. Это намеренно —
# половина контура, поднятая с забытым секретом, выглядит работающей.

# ══════════════════════════ 1. Что охраняем ══════════════════════════

# Репозитории, за которыми следит контур. ОБЯЗАТЕЛЬНО.
# Формат: owner/repo,owner2/*  — маска покрывает и репозитории, заведённые позже.
# Один список на обоих агентов: разъехавшийся охват означает PR без ревью либо
# ревью без задачи.
WATCHED_REPOS=your-org/your-repo

# Репозиторий по умолчанию для batch-скриптов (backfill, consolidate).
DEFAULT_REPO=your-org/your-repo

# ═══════════════════════ 2. Два GitHub App ═══════════════════════════
#
# Приложений именно два, и это не дублирование: у Issue-Agent свои права и свои
# события (Issues, Issue comments, sub-issues), у PR-Agent свои (Pull requests,
# Reviews, Push). Одно приложение на оба означало бы, что утечка ключа открывает
# сразу и бэклог, и код.
#
# Приватный ключ — в base64:  base64 -w0 app-private-key.pem
# Вебхук каждого App указывает на СВОЙ путь одного домена (см. PUBLIC_URL):
#   Issue-Agent → https://<host>/issue/webhook
#   PR-Agent    → https://<host>/pr/webhook

# --- App «Issue-Agent» ---
ISSUE_APP_ID=
ISSUE_APP_PRIVATE_KEY_B64=
ISSUE_APP_WEBHOOK_SECRET=          # ОБЯЗАТЕЛЬНО (openssl rand -hex 32)

# Запасной путь: PAT вместо App. github_client предпочитает токен, если он задан,
# и тогда три переменные выше можно оставить пустыми. Права: repo.
GH_TOKEN=

# --- App «PR-Agent» ---
PR_APP_ID=                         # ОБЯЗАТЕЛЬНО
PR_APP_PRIVATE_KEY_B64=            # ОБЯЗАТЕЛЬНО
PR_APP_WEBHOOK_SECRET=             # ОБЯЗАТЕЛЬНО (openssl rand -hex 32)

# ════════════════════════ 3. Замок контура ═══════════════════════════

# Секрет подписи докладов внешних агентов (POST /agent-event). ОБЯЗАТЕЛЬНО.
# Одна строка на обе стороны канала: им подписывают доставку PR-Agent и прогон
# OpenHands в Actions. Пусто → эндпоинт закрыт (503), доклады о PR и ревью не
# доходят, и задача остаётся ждать в `in-development` навсегда.
#
# ЭТУ ЖЕ строку положи секретом `AGENT_EVENT_SECRET` в каждый репозиторий из
# WATCHED_REPOS, рядом с `ISSUE_AGENT_URL=<PUBLIC_URL>/issue`.
AGENT_EVENT_SECRET=

# ═════════════════════════ 4. Модель ═════════════════════════════════

ZAI_API_KEY=                       # ОБЯЗАТЕЛЬНО
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
MODEL_GATE=glm-4.5-air
MODEL_CLASSIFY=glm-4.6
PR_AGENT_MODEL=openai/glm-4.6

# ═════════════════ 5. Насколько контур автономен ═════════════════════

# 1 — ни одной мутации в GitHub: комментарии, метки и реакции только в лог.
# Держи 1 до первого удачного прогона.
DRY_RUN=1

# Передача задачи агенту разработки. Пусто = включено.
# `0` оставляет Issue в `ready-for-dev`, то есть в очереди к живому
# разработчику, — это поведение до появления Develop и процедура отката.
DEVELOP_ENABLED=

# 1 — не парковаться на `ready-for-dev`: контур идёт от Issue до PR без единого
# касания человека. Пусто (умолчание) — разработку начинает метка `build-me`.
DEVELOP_AUTOSTART=

DEVELOP_WORKFLOW_FILE=openhands-resolver.yml
DEVELOP_REF=main

# Кто вправе запускать дорогие стадии: GitHub-логины через запятую.
# Пусто = разрешено всем. Проверяется автор события, а не наличие метки:
# `run:analyze` может поставить любой с правами на репозиторий, а прогон стоит
# токенов. Триаж новых Issue гейтом НЕ закрыт — иначе Issue от постороннего
# просто не обработается.
AGENT_TRIGGER_ALLOWLIST=

# Сроки парковок, часы (правило R3: каждое ожидание имеет дедлайн).
PARK_DECISION_HOURS=72
PARK_CLARIFICATION_HOURS=48
PARK_BUILD_HOURS=72
PARK_SIDE_STATE_HOURS=168

# ═══════════════════════ 6. Инфраструктура ═══════════════════════════

POSTGRES_PASSWORD=                 # ОБЯЗАТЕЛЬНО (openssl rand -hex 24)

# Порт харнесса на хосте. Внутри всё стандартное, наружу — только этот.
HARNESS_PORT=8080

# Публичный адрес стенда. Нужен Temporal UI для CORS и тебе — чтобы собрать
# адреса вебхуков: <PUBLIC_URL>/issue/webhook и <PUBLIC_URL>/pr/webhook.
PUBLIC_URL=http://localhost:8080

# Ветки сервисов. Меняй, чтобы поднять харнесс на доработке, не трогая compose.
ISSUE_AGENT_REF=main
PR_AGENT_REF=main
# Форки (например, приватные зеркала) — сюда же.
# ISSUE_AGENT_REPO=https://github.com/po-helper-org/poh-issue-agents.git
# PR_AGENT_REPO=https://github.com/po-helper-org/poh-pr-agents.git

# Search attributes Temporal: одна лента на всю цепочку от триажа до PR.
# ВКЛЮЧАТЬ ТОЛЬКО ПОСЛЕ регистрации атрибутов на кластере, иначе старт
# воркфлоу падает:
#   temporal operator search-attribute create --name RootIssue --type Int
#   temporal operator search-attribute create --name Repo --type Keyword
TEMPORAL_SEARCH_ATTRIBUTES=

# Sentry: пусто → выключен (это же и процедура отката).
SENTRY_DSN=
SENTRY_ENVIRONMENT=harness
