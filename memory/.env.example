# Слой саморефлексии контура — развёртывание.
#
# Обязательна ровно одна переменная: MEMORY_BASE_TOKEN. Всё остальное имеет
# умолчания, и слой работоспособен без GitHub и без модели — он просто
# накапливает меньше.

# ─────────────────────────── обязательное ───────────────────────────

# Токен, который агенты харнесса предъявляют слою. Тот же самый обязан стоять
# в `harness/.env` как MEMORY_BASE_TOKEN — это две стороны одного канала.
#
# ТОЛЬКО ASCII: значение едет заголовком HTTP `Authorization`, а заголовки
# кириллицу не принимают.
#
#   openssl rand -hex 24
MEMORY_BASE_TOKEN=

# ──────────────────── откуда собирается образ ────────────────────

# Контекст сборки одной переменной целиком, как у образов харнесса: в неё
# кладут и `…git#ветка`, и локальный путь к рабочей копии.
#
# НА СТЕНДЕ ПИНУЙ ПОЛНЫЙ SHA. BuildKit кэширует клон по URL и после нового
# коммита в ту же ветку молча собирает прежний код; короткий SHA он не находит
# вовсе.
MEMORY_CONTEXT=https://github.com/po-helper-org/harness-memory-base.git#main

# ─────────────── сколько правил доезжает до агента ───────────────

MEMORY_MAX_ITEMS=15
MEMORY_MAX_CHARS=6000

# ──────────────────── петля подтверждения ────────────────────

# Через сколько суток итерация без исхода считается созревшей по таймауту.
MEMORY_MATURATION_DAYS=7
# Сколько суток созревшая итерация может простоять необработанной, прежде чем
# попасть в наблюдаемую величину «просрочено». Нужна, чтобы отличить упавший
# проход от «созревших итераций нет».
MEMORY_OVERDUE_DAYS=2
# Урок подтверждается при K итерациях ЛИБО T днях — что раньше. Одна константа
# в итерациях при низком темпе контура не наступает никогда.
MEMORY_CONFIRM_EPISODES=5
MEMORY_CONFIRM_DAYS=30

# ──────────────────── необязательные источники ────────────────────

# Токен GitHub для сбора объективных сигналов: слит ли пул-реквест, что в
# диффе, переоткрыта ли задача. Пусто — сигналы помечаются НЕДОСТУПНЫМИ, а не
# нулевыми.
MEMORY_GITHUB_TOKEN=

# Модель судьи. Пусто — вердикт по числам, без разбора.
#
# Ключ тот же, что у контура (ZAI_API_KEY), но потребитель НОВЫЙ. Проход
# рефлексии обязан быть разведён по времени с работой агентов: ключ один на
# всё, и одновременные потребители выбивают ограничение частоты.
MEMORY_LLM_BASE_URL=
MEMORY_LLM_API_KEY=
MEMORY_LLM_MODEL=glm-4.6

# ────────────────────────── git ──────────────────────────

# Фиксировать ли накопленное коммитом. Выключено — память живёт только на томе.
MEMORY_GIT_COMMIT=1
# Отправлять ли в репозиторий. Требует прав на push внутри контейнера.
MEMORY_GIT_PUSH=0
MEMORY_GIT_BRANCH=main
